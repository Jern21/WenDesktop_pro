{
  "name": "wen-workbench-mobile",
  "private": true,
  "version": "2.1.0",
  "description": "文的项目工作台 — 移动端 PWA（独立端口，共享 backend API）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3460 --strictPort",
    "build:android": "node ../tools/mobile-android.mjs build",
    "android:sync": "node ../tools/mobile-android.mjs sync",
    "android:open": "node ../tools/mobile-android.mjs open",
