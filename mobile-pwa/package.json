    "test:android": "node ../tools/test-mobile-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  }
}
